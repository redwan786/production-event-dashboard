# Copy to .env, then fill in your NEW Supabase database details privately.
# Use the Session pooler connection string from Supabase Connect.
# Remove any sslmode or other ssl query parameters; TLS is configured in code.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/postgres
# Supabase's downloaded CA certificate, if needed. Leave empty to use Node's trusted CAs.
PG_CA_CERT_PATH=
PORT=3000
CANDIDATE_ID=04
